{
  "name": "ember-tv",
  "version": "0.2.82",
  "private": true,
  "scripts": {
    "build:webos": "node tools/build.mjs webos",
    "build:tizen": "node tools/build.mjs tizen",
    "build": "npm run build:webos && npm run build:tizen && npm run build:firetv",
    "package:webos": "node tools/package.mjs webos",
    "package:tizen": "node tools/package.mjs tizen",
    "test": "npm --prefix webos test && node --test test/*.test.cjs",
    "check": "npm --prefix webos run check",
    "build:firetv": "node tools/build.mjs firetv",
    "package:firetv": "node tools/package.mjs firetv",
    "test:menus": "npm run build && node test/menu-platform-browser.cjs",
    "test:screensaver": "npm run build && node test/screensaver-browser.cjs",
    "test:subtitle-defaults": "npm run build && node test/subtitle-defaults-browser.cjs",
    "test:anime-audio": "npm run build && node test/anime-audio-browser.cjs",
    "test:language-sync": "npm run build && node test/language-sync-browser.cjs",
    "test:seerr": "npm run build && node test/seerr-browser.cjs",
    "test:subtitle-retry": "npm run build && node test/subtitle-retry-browser.cjs",
    "test:completion": "npm run build && node test/completion-browser.cjs",
    "test:episode-entry": "npm run build && node test/episode-entry-browser.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "core-js-bundle": "^3.46.0",
    "abortcontroller-polyfill": "^1.7.8"
  }
}
